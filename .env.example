# ===========================================================================
# KLKCHAN API -- Variables de entorno
# Copia este archivo como .env y rellena los valores reales.
# NUNCA subas .env al repositorio.
#
# Onboarding rapido:
#   cp .env.example .env
#   # Edita .env y genera una SECRET_KEY con:
#   python -c "import secrets; print(secrets.token_hex(32))"
# ===========================================================================

# ---------------------------------------------------------------------------
# Seguridad JWT  (REQUERIDO)
# ---------------------------------------------------------------------------

# Clave secreta para firmar tokens JWT. SIN esta variable el servidor no arranca.
# Genera una nueva con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Algoritmo de firma (no cambiar salvo que sepas lo que haces)
ALGORITHM=HS256

# Duracion del access token en minutos
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Duracion del refresh token en dias
REFRESH_TOKEN_EXPIRE_DAYS=7

# Issuer incluido en el JWT (campo "iss")
JWT_ISS=klkchan

# ---------------------------------------------------------------------------
# Entorno de ejecucion
# ---------------------------------------------------------------------------

# Valores validos: development | production
# En "production": /docs y /redoc quedan desactivados.
# En "development": CORS permite localhost:3000/5173/8080 automaticamente.
ENVIRONMENT=development

# ---------------------------------------------------------------------------
# CORS -- dominio de produccion del frontend
# ---------------------------------------------------------------------------

# Dominio de produccion del frontend (ej. Vercel).
# En development localhost:3000/5173/8080 se permiten automaticamente.
# En production, pon aqui el dominio exacto (sin trailing slash).
# Ejemplo: https://klkchan.vercel.app
FRONTEND_ORIGIN=

# ---------------------------------------------------------------------------
# Roles iniciales  (opcional)
# ---------------------------------------------------------------------------

# Emails que reciben rol "admin" al registrarse (separados por coma).
ADMIN_EMAILS=

# Emails que reciben rol "mod" al registrarse (separados por coma).
MOD_EMAILS=

# ---------------------------------------------------------------------------
# API v2 -- hCaptcha  (opcional en development, requerido en production)
# ---------------------------------------------------------------------------

# Clave secreta de hCaptcha para verificar captchas en v2.
# En development se omite la verificacion; en production es obligatoria.
# Obtener en: https://dashboard.hcaptcha.com/
HCAPTCHA_SECRET_KEY=

# Clave secreta para firmar tokens de sesion anonima en v2.
# Genera una con: python -c "import secrets; print(secrets.token_hex(32))"
GUEST_SECRET_KEY=
